{
  "manifest_version": 3,
  "name": "Autoscroll for TikTok",
  "version": "1.0.0",
  "description": "Automatically moves to the next TikTok web video when the current one ends. Skips LIVEs and ads. Not affiliated with TikTok.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.tiktok.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Autoscroll for TikTok",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-autoscroll": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Activar / desactivar autoscroll"
    }
  },
  "homepage_url": "https://github.com/NicolasET/tiktok-autoscroll"
}
